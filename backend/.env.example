# Server Environment
PORT=5000
NODE_ENV=development
APP_NAME="Teacher Attendance & Payroll Management System"
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/teacher_attendance_payroll?schema=public"

# Redis & Background Queue (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super-secret-jwt-key-for-school-attendance-2026-very-secure
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-for-school-2026-very-secure
JWT_REFRESH_EXPIRES_IN=7d

# Data Encryption Key (32 characters hex for AES-256)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Biometric Device Webhook Secret
DEVICE_WEBHOOK_SECRET=biometric-device-secret-token-2026

# Timezone
TIMEZONE=Asia/Kolkata

# File Upload Paths
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

